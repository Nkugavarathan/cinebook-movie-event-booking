# Copy this file to cinebook-server/.env and fill in your values. .env is gitignored.

# Stripe (Dashboard -> Developers -> API keys). Use TEST keys (sk_test_...).
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen --forward-to localhost:8080/api/payments/webhook` (optional locally)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Currency for prices and Stripe Checkout: lkr (Sri Lankan rupee) or usd, inr, eur ...
APP_CURRENCY=lkr

# Database
DB_USERNAME=root
DB_PASSWORD=

# Long random string (32+ chars)
JWT_SECRET=change_me_to_a_long_random_secret_value_123456

# Default admin login
ADMIN_EMAIL=admin@cinebook.com
ADMIN_PASSWORD=Admin@123

# Gmail SMTP for ticket emails. Create an App Password: Google Account -> Security -> 2-Step Verification -> App passwords
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=your_16_char_app_password

# Booking assistant (chat + natural voice). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Aoede
# Path to an edited copy of src/main/resources/assistant/knowledge-base.md (optional)
# ASSISTANT_KB_FILE=
